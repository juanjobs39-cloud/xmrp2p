{
  "name": "xmrp2p-workers",
  "private": true,
  "type": "module",
  "description": "Backend de MoneroP2P en Cloudflare: libro de órdenes (D1), canal (Durable Objects), proxy de nodos Monero, API pública y MCP de solo lectura, cotizaciones vía Trocador, y la API de P2P Fiat con su bot de Telegram",
  "scripts": {
    "dev": "wrangler dev",
    "dev:proxy": "wrangler dev -c wrangler.node-proxy.toml",
    "dev:proxy-mainnet": "wrangler dev -c wrangler.node-proxy-mainnet.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
