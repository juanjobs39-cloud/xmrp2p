{
  "name": "xmrp2p-workers",
  "private": true,
  "type": "module",
  "description": "Backend de xmrp2p en Cloudflare: libro de órdenes (D1), canal (Durable Objects), proxy de nodos Monero, API pública y MCP de solo lectura",
  "scripts": {
    "dev": "wrangler dev",
    "dev:proxy": "wrangler dev -c wrangler.node-proxy.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "2.57.11"
  },
  "devDependencies": {
    "wrangler": "4.152.0",
    "vitest": "4.1.12",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "typescript": "5.9.3",
    "@cloudflare/workers-types": "5.20261024.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12"
  }
}
