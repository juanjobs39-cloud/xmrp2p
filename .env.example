# Copia este archivo a .env y llena los valores. .env NUNCA se sube a Git.
# No pongas aquí llaves privadas de mainnet. Para testnet usa wallets desechables.

# RPCs de redes EVM (testnet)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Llave privada de despliegue SOLO para testnet (dejar vacío si usas un keystore de Foundry)
TESTNET_DEPLOYER_PRIVATE_KEY=

# Tron (testnet Nile)
TRON_NILE_FULLNODE=https://nile.trongrid.io
TRONGRID_API_KEY=

# Monero (stagenet)
MONERO_STAGENET_DAEMON=http://stagenet.xmr-tw.org:38081

# Cloudflare (los toma wrangler; normalmente basta con `wrangler login`)
CLOUDFLARE_ACCOUNT_ID=

# IndexNow
INDEXNOW_KEY=
