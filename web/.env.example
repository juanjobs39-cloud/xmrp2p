# Copia a web/.env (ignorado por Git). Valores públicos: terminan en el HTML.
PUBLIC_SITE_URL=https://[DOMINIO]
PUBLIC_BRAND=xmrp2p
PUBLIC_CONTACT_EMAIL=[EMAIL_CONTACTO]

# Backend de Cloudflare (Fase 4) y nodo de Monero por defecto (proxy en la raíz de su host)
PUBLIC_API_URL=https://xmrp2p-api.<subdominio>.workers.dev
PUBLIC_MONERO_NODE=https://xmrp2p-node-proxy.<subdominio>.workers.dev

# Contrato en Arbitrum Sepolia (contracts/README.md → Desplegar)
PUBLIC_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
PUBLIC_ARBITRUM_SEPOLIA_FACTORY=0x0000000000000000000000000000000000000000
PUBLIC_ARBITRUM_SEPOLIA_TOKEN=0x0000000000000000000000000000000000000000

# IndexNow (genera /<llave>.txt al construir)
INDEXNOW_KEY=
