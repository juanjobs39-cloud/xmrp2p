---
import Base from "../../../layouts/Base.astro";
import { ROUTES, SITE, type Lang } from "../../../site";
import NetSwitch from "../../../components/NetSwitch.astro";
import Verified from "../../../components/Verified.astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}
const lang = Astro.params.lang as Lang;
const t = (es: string, en: string) => (lang === "es" ? es : en);
const factory = import.meta.env.PUBLIC_ARBITRUM_SEPOLIA_FACTORY ?? "";
const factoryReal = import.meta.env.PUBLIC_ARBITRUM_ONE_FACTORY ?? "";

// CSP estricta: solo código propio. 'wasm-unsafe-eval' es necesario para WebAssembly
// (núcleo cripto y monero-ts); no habilita eval de JavaScript.
const hosts = [SITE.apiUrl, import.meta.env.PUBLIC_ARBITRUM_SEPOLIA_RPC ?? "https://sepolia-rollup.arbitrum.io/rpc", import.meta.env.PUBLIC_MONERO_NODE ?? ""]
  .filter(Boolean)
  .map((u) => new URL(u).origin);
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "worker-src 'self' blob:",
  `connect-src 'self' ${hosts.join(" ")} https: http://127.0.0.1:* http://localhost:*`,
  "img-src 'self' data:",
  "style-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: `${SITE.brand} — app de swap USDT → XMR`,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web (navegador)",
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  softwareVersion: "0.1.0 (testnet)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---
<Base
  lang={lang}
  route="app"
  csp={csp}
  title={t("App: cambiar USDT por Monero", "App: swap USDT for Monero")}
  description={t(
    "Haz un atomic swap de USDT a XMR desde tu navegador, sin cuenta y sin que nadie custodie tus fondos. Versión de prueba en testnet.",
    "Do a USDT to XMR atomic swap from your browser, with no account and nobody holding your funds. Testnet preview.",
  )}
  jsonLd={[softwareLd]}
>
  <main id="contenido" class="prose" data-lang={lang}>
    <h1>{t("Cambiar USDT por XMR", "Swap USDT for XMR")} <span class="badge only-test">Testnet</span><span class="badge real only-real">{t("Dinero real", "Real money")}</span></h1>
    <NetSwitch lang={lang} />
    <p class="notice warn only-test">
      {t(
        "Modo práctica: Arbitrum Sepolia + Monero stagenet. Los fondos no tienen valor.",
        "Practice mode: Arbitrum Sepolia + Monero stagenet. Funds have no value.",
      )}
    </p>
    <p class="notice danger only-real">
      {t(
        "Dinero real (Arbitrum One + Monero). Máximo 100 USDT por swap.",
        "Real money (Arbitrum One + Monero). Maximum 100 USDT per swap.",
      )}
    </p>
    <ul class="trust">
      <li><strong>{t("Sin custodia", "Non-custodial")}</strong> {t("Tus llaves se generan y se quedan en tu navegador.", "Your keys are created and stay in your browser.")}</li>
      <li><strong>{t("Contrato público", "Public contract")}</strong> <a class="only-test" href={`https://sepolia.arbiscan.io/address/${factory}`} rel="noopener">{t("Ver en Arbiscan", "View on Arbiscan")}</a><a class="only-real" href={`https://arbiscan.io/address/${factoryReal}`} rel="noopener">{t("Ver en Arbiscan", "View on Arbiscan")}</a></li>
      <li><strong>{t("Código abierto", "Open source")}</strong> <a href={SITE.repo} rel="noopener">AGPL-3.0</a></li>
      <li><strong>{t("Comisión 0,5 %", "0.5% fee")}</strong> {t("La paga el maker al cobrar; tú solo pagas el gas.", "Paid by the maker on claim; you only pay gas.")}</li>
    </ul>
    <Verified lang={lang} compact />
    <ol id="stepper" class="stepper" title={t("Etapas del swap", "Swap stages")}>
      <li data-stage="step-start">{t("Oferta", "Offer")}</li>
      <li data-stage="step-recovery">{t("Respaldo", "Backup")}</li>
      <li data-stage="step-deposit">{t("Depósito", "Deposit")}</li>
      <li data-stage="step-progress">{t("Seguimiento", "Progress")}</li>
      <li data-stage="done">{t("Listo", "Done")}</li>
    </ol>
    <p class="notice danger">
      {t(
        "No cierres esta pestaña hasta terminar. Si se cierra, vuelve con tu archivo de recuperación: sin él no podrás reclamar el XMR ni reembolsar el USDT. Un swap tarda normalmente entre 30 y 60 minutos.",
        "Do not close this tab until it finishes. If it closes, come back with your recovery file: without it you cannot claim the XMR or refund the USDT. A swap normally takes 30 to 60 minutes.",
      )}
    </p>
    <div id="banner" class="notice" hidden role="alert"></div>
    <p id="status" aria-live="polite"></p>
    <p id="wallet-step" class="notice" hidden aria-live="polite"></p>

    <section id="step-start" data-step>
      <h2>{t("1. Elige oferta y monto", "1. Pick an offer and amount")}</h2>
      <form id="form-start" class="app">
        <div class="field">
          <label for="offer">{t("Oferta", "Offer")}</label>
          <span class="row"><select id="offer" required></select><button class="btn secondary small" id="btn-offers" type="button">{t("Actualizar", "Refresh")}</button></span>
        </div>
        <label>{t("Monto en USDT", "Amount in USDT")}<input id="usdt" type="text" inputmode="decimal" required placeholder="100" /></label>
        <label>
          <span class="only-test">{t("Tu dirección de Monero (stagenet)", "Your Monero address (stagenet)")}</span><span class="only-real">{t("Tu dirección de Monero", "Your Monero address")}</span>
          <input id="destination" type="text" required autocomplete="off" spellcheck="false" />
          <small>{t("Aquí recibirás el XMR al final.", "This is where you will receive the XMR.")}</small>
        </label>
        <label>
          {t("Contraseña del archivo de recuperación", "Recovery file password")}
          <input id="passphrase" type="password" minlength="10" required autocomplete="new-password" />
          <small>{t("Mínimo 10 caracteres. No la podemos recuperar por ti.", "At least 10 characters. We cannot recover it for you.")}</small>
        </label>
        <label>
          {t("Nodo de Monero", "Monero node")}
          <input id="node" type="url" required spellcheck="false" />
          <small>{t("Puedes usar tu propio nodo (con CORS y HTTPS).", "You can use your own node (with CORS and HTTPS).")}</small>
        </label>
        <button class="btn" type="submit">{t("Pedir el swap", "Request the swap")}</button>
      </form>
    </section>

    <section id="step-recovery" data-step hidden>
      <h2>{t("2. Descarga tu archivo de recuperación", "2. Download your recovery file")}</h2>
      <p id="quote"></p>
      <p>{t(
        "Es obligatorio. Está cifrado con tu contraseña y contiene tu mitad de la llave: con él puedes reanudar el swap, reclamar el XMR o reembolsar el USDT desde cualquier navegador.",
        "It is required. It is encrypted with your password and contains your half of the key: with it you can resume, claim the XMR or refund the USDT from any browser.",
      )}</p>
      <button class="btn" id="btn-recovery" type="button">{t("Descargar archivo de recuperación", "Download recovery file")}</button>
    </section>

    <section id="step-deposit" data-step hidden>
      <h2>{t("3. Deposita el USDT", "3. Deposit the USDT")}</h2>
      <p>{t(
        "Tu wallet (MetaMask o compatible) te pedirá firmar. El USDT queda en un contrato que solo libera al maker cuando tú lo confirmas, o te lo devuelve si algo falla.",
        "Your wallet (MetaMask or compatible) will ask you to sign. The USDT goes into a contract that only pays the maker after you confirm, or refunds you if something fails.",
      )}</p>
      <button class="btn" id="btn-deposit" type="button">{t("Conectar wallet y depositar", "Connect wallet and deposit")}</button>
    </section>

    <section id="step-progress" data-step hidden>
      <h2>{t("4. Progreso del swap", "4. Swap progress")}</h2>
      <p id="timeline" class="meta"></p>
      <div class="lock-box">
        <p id="action-text" aria-live="polite"></p>
        <progress id="xmr-progress" max="10" value="0" hidden></progress>
      </div>
      <button class="btn" id="btn-action" type="button" hidden></button>
      <ol class="meta">
        <li>{t("El maker bloquea el XMR en una dirección del swap (todavía no es tuyo).", "The maker locks the XMR at a swap address (not yours yet).")}</li>
        <li>{t("La red de Monero lo confirma: hacen falta 10 confirmaciones (~20 min).", "The Monero network confirms it: 10 confirmations are needed (~20 min).")}</li>
        <li>{t("Tú confirmas con el botón «Confirmar y recibir mi XMR». El maker cobra su USDT.", "You confirm with the «Confirm and receive my XMR» button. The maker claims their USDT.")}</li>
        <li>{t("La app envía el XMR a tu dirección automáticamente.", "The app sends the XMR to your address automatically.")}</li>
      </ol>
    </section>

    <section id="step-restore" data-step hidden>
      <h2>{t("Reanudar un swap", "Resume a swap")}</h2>
      <p id="saved-note" class="notice warn"></p>
      <form id="form-restore" class="app">
        <label>{t("Archivo de recuperación (opcional si es este navegador)", "Recovery file (optional on this browser)")}<input id="restore-file" type="file" accept=".json,application/json" /></label>
        <label>{t("Contraseña", "Password")}<input id="restore-pass" type="password" required autocomplete="current-password" /></label>
        <button class="btn" type="submit">{t("Reanudar", "Resume")}</button>
      </form>
      <p><button class="btn secondary" id="btn-discard" type="button">{t("Descartar el swap guardado", "Discard the saved swap")}</button></p>
    </section>
    <p class="meta">{t("¿Tienes XMR?", "Have XMR?")} <a href={ROUTES.makerApp[lang]}><strong>{t("Ser maker y ganar un margen →", "Be a maker and earn a margin →")}</strong></a></p>
    <p><a href="#step-restore" id="link-restore">{t("¿Tienes un archivo de recuperación? Reanudar", "Have a recovery file? Resume")}</a></p>
    <noscript><p class="notice danger">{t("La app necesita JavaScript. El resto del sitio funciona sin él.", "The app needs JavaScript. The rest of the site works without it.")}</p></noscript>
  </main>
</Base>

<script>
  import { SwapApp } from "../../../app/app";
  const lang = (document.querySelector("main")?.dataset.lang ?? "es") as "es" | "en";
  const app = new SwapApp(lang);
  void app.mount();
  document.getElementById("link-restore")?.addEventListener("click", () => {
    const r = document.getElementById("step-restore");
    if (r) r.hidden = false;
  });
</script>
