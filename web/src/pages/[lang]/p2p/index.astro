---
// P2P Fiat (beta, solo en/es): solo se construye con PUBLIC_P2P=on. Sin entrada en ROUTES (no hreflang ni sitemap).
import { makeT } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";
import { SITE, type Lang } from "../../../site";

export function getStaticPaths() {
  if (import.meta.env.PUBLIC_P2P !== "on") return [];
  return (["en", "es"] as const).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = makeT(lang);

const api = import.meta.env.PUBLIC_P2P_API_URL ?? SITE.apiUrl;
const hosts = [api, import.meta.env.PUBLIC_MONERO_NODE ?? "", import.meta.env.PUBLIC_MONERO_NODE_MAINNET ?? ""]
  .filter(Boolean)
  .map((u) => new URL(u).origin);
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "worker-src 'self' blob:",
  `connect-src 'self' ${hosts.join(" ")} https: http://127.0.0.1:* http://localhost:*`,
  "img-src 'self' data:",
  "style-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");
---
<Base
  lang={lang}
  csp={csp}
  noindex
  title={t("P2P Fiat (beta)", "P2P Fiat (beta)")}
  description={t(
    "Compra y vende Monero por pesos, dólares, euros o cualquier moneda, de persona a persona, con escrow 2 de 3.",
    "Buy and sell Monero for any currency, person to person, with a 2-of-3 escrow.",
  )}
  footerNote={t(
    "⚠️ Beta en red de prueba (Monero stagenet): no uses dinero real. Tope de 1000 USD por orden. Las transacciones de cripto son irreversibles, el precio es volátil y tú eres responsable de cumplir las leyes de tu país.",
    "⚠️ Beta on the test network (Monero stagenet): do not use real money. 1000 USD cap per order. Crypto transactions are irreversible, prices are volatile and you are responsible for complying with your country's laws.",
  )}
>
  <main id="contenido" class="prose wide p2p-page" data-lang={lang}>
    <header class="p2p-hero">
      <div>
        <h1>P2P Fiat <span class="badge">Beta</span></h1>
        <p class="lead">{t(
          "Compra y vende XMR por cualquier moneda, de persona a persona. El XMR queda en un escrow 2 de 3 hasta que el vendedor confirma tu pago.",
          "Buy and sell XMR for any currency, person to person. The XMR stays in a 2-of-3 escrow until the seller confirms your payment.",
        )}</p>
      </div>
      <ul class="p2p-trust">
        <li><b>🔒</b> {t("Escrow 2 de 3, sin custodia", "2-of-3 escrow, non-custodial")}</li>
        <li><b>🙈</b> {t("Sin KYC ni correo", "No KYC, no email")}</li>
        <li><b>💬</b> {t("Chat cifrado", "Encrypted chat")}</li>
        <li><b>%</b> {t("0.5% solo para quien vende", "0.5% fee, seller only")}</li>
      </ul>
      <p class="p2p-testnet">{t("Red de prueba (stagenet): no uses dinero real.", "Test network (stagenet): do not use real money.")}</p>
    </header>
    <nav class="p2p-nav" id="p2p-nav" aria-label="P2P"></nav>
    <div id="p2p-root"><div class="p2p-skel-list"><div class="p2p-skel"></div><div class="p2p-skel"></div><div class="p2p-skel"></div></div></div>
    <noscript><p class="notice danger">{t("P2P Fiat necesita JavaScript.", "P2P Fiat needs JavaScript.")}</p></noscript>
  </main>
</Base>

<script>
  import { P2PApp } from "../../../p2p/p2p-app";
  const lang = document.querySelector("main")?.dataset.lang === "es" ? "es" : "en";
  void new P2PApp(lang).mount();
</script>
