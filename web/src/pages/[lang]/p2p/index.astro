---
// P2P Fiat (beta, solo en/es): solo se construye con PUBLIC_P2P=on. Sin entrada en ROUTES (no hreflang ni sitemap).
import { makeT } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";
import { SITE, type Lang } from "../../../site";

export function getStaticPaths() {
  if (import.meta.env.PUBLIC_P2P !== "on") return [];
  return (["en", "es"] as const).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = makeT(lang);

const api = import.meta.env.PUBLIC_P2P_API_URL ?? SITE.apiUrl;
const hosts = [api, import.meta.env.PUBLIC_MONERO_NODE ?? "", import.meta.env.PUBLIC_MONERO_NODE_MAINNET ?? ""]
  .filter(Boolean)
  .map((u) => new URL(u).origin);
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "worker-src 'self' blob:",
  `connect-src 'self' ${hosts.join(" ")} https: http://127.0.0.1:* http://localhost:*`,
  "img-src 'self' data:",
  "style-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");
---
<Base
  lang={lang}
  csp={csp}
  noindex
  title={t("P2P Fiat (beta)", "P2P Fiat (beta)")}
  description={t(
    "Compra y vende Monero por pesos, dólares, euros o cualquier moneda, de persona a persona, con escrow 2 de 3.",
    "Buy and sell Monero for any currency, person to person, with a 2-of-3 escrow.",
  )}
>
  <main id="contenido" class="prose wide" data-lang={lang}>
    <h1>P2P Fiat <span class="badge">Beta</span></h1>
    <p class="lead">{t(
      "Compra y vende XMR por cualquier moneda, de persona a persona. El XMR queda en un escrow 2 de 3 hasta que el vendedor confirma tu pago.",
      "Buy and sell XMR for any currency, person to person. The XMR stays in a 2-of-3 escrow until the seller confirms your payment.",
    )}</p>
    <p class="notice warn">{t(
      "Beta en red de prueba (Monero stagenet): no uses dinero real. Comisión del 0.5% para quien vende. Tope de 1000 USD por orden.",
      "Beta on the test network (Monero stagenet): do not use real money. 0.5% fee for the seller. 1000 USD cap per order.",
    )}</p>
    <nav class="p2p-nav" id="p2p-nav" aria-label="P2P"></nav>
    <div id="p2p-root"><p>{t("Cargando…", "Loading…")}</p></div>
    <noscript><p class="notice danger">{t("P2P Fiat necesita JavaScript.", "P2P Fiat needs JavaScript.")}</p></noscript>
  </main>
</Base>

<script>
  import { P2PApp } from "../../../p2p/p2p-app";
  const lang = document.querySelector("main")?.dataset.lang === "es" ? "es" : "en";
  void new P2PApp(lang).mount();
</script>
