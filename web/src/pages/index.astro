---
// Raíz: redirige a español (idioma por defecto) sin JavaScript.
import { SITE } from "../site";
const es = new URL("/es/", Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.brand}</title>
    <meta http-equiv="refresh" content="0; url=es/" />
    <link rel="canonical" href={es} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={es} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p><a href="es/">Español</a> · <a href="en/">English</a></p>
  </body>
</html>
