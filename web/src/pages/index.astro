---
// Raíz: redirige a inglés (idioma por defecto) sin JavaScript.
import { LANG_INFO, LANGS, SITE } from "../site";
const en = new URL("/en/", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.brand}</title>
    <meta http-equiv="refresh" content="0; url=en/" />
    <link rel="canonical" href={en} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={en} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <ul>{LANGS.map((l) => <li><a href={`${l}/`} lang={l}>{LANG_INFO[l].name}</a></li>)}</ul>
  </body>
</html>
