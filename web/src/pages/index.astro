---
// Raíz: abre la app de swaps (Trocador + atómicos) en el idioma del navegador; si no se reconoce, inglés.
// Sin JavaScript, va a la app en inglés. La portada informativa sigue en /<idioma>/ (enlazada con hreflang).
import { LANG_INFO, LANGS, ROUTES, SITE } from "../site";
const en = new URL("/en/", Astro.site).href;
const apps = Object.fromEntries(LANGS.map((l) => [l, ROUTES.app[l]]));
const pick = `(function(){var a=${JSON.stringify(apps)},L=navigator.languages||[navigator.language||"en"];for(var i=0;i<L.length;i++){var c=String(L[i]).toLowerCase().split("-")[0];if(a[c]){location.replace(a[c]+location.search+location.hash);return}}location.replace(a.en+location.search+location.hash)})()`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.brand}</title>
    <script is:inline set:html={pick} />
    <noscript><meta http-equiv="refresh" content={`0; url=${ROUTES.app.en}`} /></noscript>
    <link rel="canonical" href={en} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={en} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <ul>{LANGS.map((l) => <li><a href={ROUTES.app[l]} lang={l}>{LANG_INFO[l].name}</a></li>)}</ul>
  </body>
</html>
