---
import { makeT } from "../i18n/ui";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { fiatHref, LANG_INFO, LANGS, NAV, ROUTES, SITE, type Lang } from "../site";
import { newsIndex } from "../lib/content";

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** clave de ROUTES para hreflang y selector de idioma */
  route?: keyof typeof ROUTES;
  /** rutas alternativas explícitas (guías) */
  alternates?: Partial<Record<Lang, string>>;
  jsonLd?: object[];
  breadcrumbs?: { name: string; href: string }[];
  /** CSP estricta para la app (las páginas de contenido no tienen JS) */
  csp?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  markdownAlternate?: string;
  /** aviso del pie propio de la página (si no, el del swap) */
  footerNote?: string;
}

const { lang, title, description, route, jsonLd = [], breadcrumbs, csp, ogType = "website", noindex, markdownAlternate, footerNote } = Astro.props;
const site = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const alternates: Partial<Record<Lang, string>> = Astro.props.alternates ?? (route ? ROUTES[route] : {});
const fullTitle = route === "home" ? title : `${title} · ${SITE.brand}`;
const others = LANGS.filter((l) => l !== lang && alternates[l]);
const t = makeT(lang);

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.brand,
  url: site.href,
  logo: new URL("/favicon-192.png", site).href,
  sameAs: [SITE.repo],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.brand,
  url: site.href,
  inLanguage: LANGS,
};
const crumbs = breadcrumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: new URL(b.href, site).href })),
};
const ld = [org, website, ...(crumbs ? [crumbs] : []), ...jsonLd];
---
<!doctype html>
<html lang={lang} dir={LANG_INFO[lang].rtl ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href!, site).href} />)}
    {(alternates.en ?? alternates.es) && <link rel="alternate" hreflang="x-default" href={new URL((alternates.en ?? alternates.es)!, site).href} />}
    {markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content={LANG_INFO[lang].og} />
    {others.map((l) => <meta property="og:locale:alternate" content={LANG_INFO[l].og} />)}
    <meta property="og:image" content={new URL("/og.png?v=3", site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#090b10" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">{t("Saltar al contenido", "Skip to content")}</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={ROUTES.home[lang]}><img src="/favicon.svg?v=3" alt="" width="28" height="28" />{SITE.brand}</a>
        <nav aria-label={t("Principal", "Main")}>
          <ul>
            {NAV.map((n) => (
              <li><a href={ROUTES[n.key][lang]} aria-current={path === ROUTES[n.key][lang] ? "page" : undefined}>{t(n.es, n.en)}</a></li>
            ))}
            <li><a class="nav-cta" href={fiatHref(lang)}>{t("P2P Fiat", "P2P Fiat")} <span class="nav-new">{t("Nuevo", "New")}</span></a></li>
            <li><a class="nav-cta" href={ROUTES.makerApp[lang]} aria-current={path === ROUTES.makerApp[lang] ? "page" : undefined}>{t("Ser maker", "Be a maker")}</a></li>
            <li><a class="nav-cta primary" href={ROUTES.app[lang]} aria-current={path === ROUTES.app[lang] ? "page" : undefined}>{t("Swaps cripto", "Crypto swaps")}</a></li>
          </ul>
        </nav>
        {others.length > 0 && (
          <details class="lang">
            <summary aria-label={`${t("Idioma", "Language")}: ${LANG_INFO[lang].name}`} title={LANG_INFO[lang].name}><Icon name="globe" /> {lang.toUpperCase()}</summary>
            <ul>
              {others.map((l) => (
                <li><a href={alternates[l]} hreflang={l} lang={l} dir={LANG_INFO[l].rtl ? "rtl" : "ltr"}>{LANG_INFO[l].name}</a></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </header>
    {breadcrumbs && (
      <nav class="breadcrumbs wrap" aria-label={t("Migas de pan", "Breadcrumbs")}>
        <ol>{breadcrumbs.map((b, i) => <li>{i < breadcrumbs.length - 1 ? <a href={b.href}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol>
      </nav>
    )}
    <slot />
    <footer class="site">
      <div class="wrap">
        <p class="notice warn">
          {footerNote ?? t(
            "⚠️ Máximo 100 USDT por swap. Las transacciones de cripto son irreversibles, el precio es volátil, el emisor de USDT puede congelar direcciones y tú eres responsable de cumplir las leyes de tu país.",
            "⚠️ Maximum 100 USDT per swap. Crypto transactions are irreversible, prices are volatile, the USDT issuer can freeze addresses, and you are responsible for complying with your country's laws.",
          )}{" "}
          <a href={ROUTES.risks[lang]}>{t("Aviso de riesgos", "Risk notice")}</a>
        </p>
        <div class="foot-grid">
          <div class="foot-about">
            <a class="brand" href={ROUTES.home[lang]}><img src="/favicon.svg?v=3" alt="" width="26" height="26" loading="lazy" />{SITE.brand}</a>
            <p>{t("Nadie custodia tus fondos: ni nosotros ni los makers.", "Nobody holds your funds: not us, not the makers.")}</p>
          </div>
          <div class="foot-col">
            <p class="foot-h">{t("Producto", "Product")}</p>
            <ul>
              <li><a href={ROUTES.wallet[lang]}>MoneroP2P Wallet</a></li>
              <li><a href={newsIndex(lang)}>{t("Novedades", "News")}</a></li>
              <li><a href={ROUTES.glossary[lang]}>{t("Glosario", "Glossary")}</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <p class="foot-h">{t("Proyecto", "Project")}</p>
            <ul>
              <li><a href={ROUTES.about[lang]}>{t("Acerca de", "About")}</a></li>
              <li><a href={ROUTES.contact[lang]}>{t("Contacto", "Contact")}</a></li>
              <li><a href={SITE.repo} rel="noopener">{t("Código fuente (AGPL-3.0)", "Source code (AGPL-3.0)")}</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <p class="foot-h">Legal</p>
            <ul>
              <li><a href={ROUTES.terms[lang]}>{t("Términos de uso", "Terms of use")}</a></li>
              <li><a href={ROUTES.privacy[lang]}>{t("Privacidad", "Privacy")}</a></li>
              <li><a href={ROUTES.risks[lang]}>{t("Aviso de riesgos", "Risk notice")}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bar">
          <p>© {SITE.brand}</p>
          <ul class="foot-chips">
            <li><Icon name="shield" />{t("Sin custodia", "Non-custodial")}</li>
            <li><Icon name="code" />{t("Código abierto", "Open source")}</li>
            <li><Icon name="user" />{t("Sin cuentas", "No accounts")}</li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
