    <h2 lang="es">Página no encontrada</h2>
    <p lang="es"><a href={ROUTES.home.es}>Inicio</a> · <a href={ROUTES.app.es}>Mercado</a> · <a href={ROUTES.how.es}>Cómo funciona</a> · <a href={ROUTES.methods.es}>Métodos de pago</a> · <a href={ROUTES.faq.es}>Preguntas frecuentes</a></p>
