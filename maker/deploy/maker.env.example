# Secretos del maker. Copia a /etc/xmrp2p/maker.env (Linux) o a un archivo fuera del repo,
# con permisos 600 (solo el usuario del maker puede leerlo). NUNCA lo subas a Git.
#
#   sudo install -m 600 -o xmrp2p -g xmrp2p maker.env.example /etc/xmrp2p/maker.env

# Llave privada de la cuenta EVM del maker (solo testnet). Firma ofertas y envía `claim`.
MAKER_EVM_PRIVATE_KEY=0xCAMBIA_ESTO

# Credenciales de monero-wallet-rpc (las mismas que en --rpc-login usuario:contraseña).
MONERO_WALLET_RPC_USER=maker
MONERO_WALLET_RPC_PASSWORD=CAMBIA_ESTO

# Contraseña de la wallet principal (para reabrirla tras recuperar un XMR).
MONERO_MAIN_WALLET_PASSWORD=CAMBIA_ESTO
